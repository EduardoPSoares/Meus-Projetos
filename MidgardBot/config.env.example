# ==========================================
#        MIDGARD BOT CONFIGURATION (EXEMPLO)
# ==========================================
# Renomeie este arquivo para 'config.env' e preencha com seus dados reais.

# ------------------------------------------
# 1. Configurações Básicas
# ------------------------------------------
# Token do bot (Obtido no Discord Developer Portal)
TOKEN=SEU_TOKEN_AQUI

# Prefixo para comandos de texto (ex: !ping)
PREFIX=!

# ------------------------------------------
# 2. Canais (IDs dos canais de texto)
# ------------------------------------------
STAFF_CHANNEL_ID=000000000000000000
RESULTS_CHANNEL_ID=000000000000000000
PUNISHMENT_CHANNEL_ID=000000000000000000
# PUNISHMENT_FORUM_ID: Canal fórum onde punições são postadas como threads.
PUNISHMENT_FORUM_ID=000000000000000000
BACKUP_CHANNEL_ID=000000000000000000
WELCOME_CHANNEL_ID=000000000000000000
STAFF_FEEDBACK_CHANNEL_ID=000000000000000000
LOG_CHANNEL_ID=000000000000000000
STATUS_CHANNEL_ID=000000000000000000

# ------------------------------------------
# 3. Cargos (IDs dos cargos)
# ------------------------------------------
CITIZEN_ROLE_ID=000000000000000000
NOTIFICATION_ROLE_ID=000000000000000000
UNDER_AGE_ROLE_ID=000000000000000000

# ------------------------------------------
# 4. Permissões (Controle de Acesso)
# ------------------------------------------
# IDs de cargos separados por vírgula
PERM_CMD_BAN=
PERM_CMD_KICK=
PERM_CMD_WARN=
PERM_CMD_UNWARN=
PERM_CMD_UNBAN=
PERM_CMD_CLEAR=
PERM_CMD_MAINTENANCE=
PERM_CMD_BACKUP=
PERM_CMD_BLACKLIST=
PERM_CMD_WHITELIST=
PERM_CMD_WHITELIST_MANAGE=
PERM_CMD_STAFFSTATS=
PERM_CMD_DEBUG=
# ------------------------------------------
# 7. Sistema de Tickets
# ------------------------------------------
TICKET_CATEGORY_SUPPORT=000000000000000000
TICKET_CATEGORY_REPORT=000000000000000000
TICKET_CATEGORY_BUG=000000000000000000
TICKET_CATEGORY_LORE=000000000000000000
TICKET_CATEGORY_LOG=000000000000000000

TICKET_SUPPORT_ROLES=000000000000000000
TICKET_ROLE_SUPPORT=000000000000000000
TICKET_ROLE_REPORT=000000000000000000
TICKET_ROLE_BUG=000000000000000000
TICKET_ROLE_LORE=000000000000000000

# Horário de Atendimento
TICKET_SCHEDULE_ENABLED=true
TICKET_SCHEDULE_TIMEZONE=America/Sao_Paulo
TICKET_WEEKDAY_START=12
TICKET_WEEKDAY_END=19
TICKET_WEEKEND_START=12
TICKET_WEEKEND_END=14

# ------------------------------------------
# 8. Configuração do Servidor (Minecraft/Socket)
# ------------------------------------------
SERVER_IP=127.0.0.1
LOBBY_PORT=25565
RPG_PORT=25568
SOCKET_PORT=25590
SOCKET_SECRET=midgard_secret_key_change_me

# ------------------------------------------
# 9. Servidores Discord
# ------------------------------------------
# ID do servidor principal
MAIN_GUILD_ID=000000000000000000
# ID do servidor exclusivo de staffs (somente /reuniao)
STAFF_GUILD_ID=000000000000000000

# ------------------------------------------
# 10. Sistema de Intimações (Audiências)
# ------------------------------------------
INTIMACAO_CATEGORY_ID=000000000000000000
INTIMACAO_LOG_CHANNEL_ID=000000000000000000
PERM_CMD_INTIMAR=000000000000000000

# ------------------------------------------
# 10. Banco de Dados
# ------------------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=midgard
DB_USER=root
DB_PASS=senha

# ------------------------------------------
# 11. Painel Web Administrativo
# ------------------------------------------
WEB_ENABLED=true
WEB_PORT=7070
WEB_SECRET=troque-para-uma-chave-segura-aleatoria
DISCORD_CLIENT_ID=SEU_CLIENT_ID_AQUI
DISCORD_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
WEB_REDIRECT_URI=http://localhost:7070/callback
WEB_ALLOWED_ROLES=000000000000000000

# ------------------------------------------
# 11. GitHub (Notícias do Launcher)
# ------------------------------------------
# Token do GitHub com permissão 'repo' para publicar notícias no MidgardLauncher
GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI
