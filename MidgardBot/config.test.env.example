# ==========================================
#    MIDGARD BOT - CONFIGURAÇÃO DE TESTE
# ==========================================
# Renomeie este arquivo para 'config.test.env' e preencha com os dados do servidor de teste.
# Para usar: java -jar MidgardBot.jar --profile test
#
# Este arquivo é carregado NO LUGAR do config.env quando o perfil "test" está ativo.
# Isso permite testar funcionalidades sem afetar o servidor principal.

# ------------------------------------------
# 1. Configurações Básicas
# ------------------------------------------
# Use um BOT DIFERENTE do de produção (crie outro no Discord Developer Portal)
TOKEN=SEU_TOKEN_DO_BOT_DE_TESTE

PREFIX=!

# ------------------------------------------
# 2. Canais (IDs do servidor de TESTE)
# ------------------------------------------
STAFF_CHANNEL_ID=
RESULTS_CHANNEL_ID=
PUNISHMENT_CHANNEL_ID=
BACKUP_CHANNEL_ID=
WELCOME_CHANNEL_ID=
STAFF_FEEDBACK_CHANNEL_ID=
LOG_CHANNEL_ID=
STATUS_CHANNEL_ID=

# ------------------------------------------
# 3. Cargos (IDs do servidor de TESTE)
# ------------------------------------------
CITIZEN_ROLE_ID=
NOTIFICATION_ROLE_ID=
UNDER_AGE_ROLE_ID=

# ------------------------------------------
# 4. Permissões (Controle de Acesso)
# ------------------------------------------
PERM_CMD_BAN=
PERM_CMD_KICK=
PERM_CMD_WARN=
PERM_CMD_UNWARN=
PERM_CMD_UNBAN=
PERM_CMD_CLEAR=
PERM_CMD_MAINTENANCE=
PERM_CMD_BACKUP=
PERM_CMD_BLACKLIST=
PERM_CMD_WHITELIST=
PERM_CMD_WHITELIST_MANAGE=
PERM_CMD_STAFFSTATS=
PERM_CMD_DEBUG=
# ------------------------------------------
# 5. Sistema de Tickets (IDs do servidor de TESTE)
# ------------------------------------------
TICKET_CATEGORY_SUPPORT=
TICKET_CATEGORY_REPORT=
TICKET_CATEGORY_BUG=
TICKET_CATEGORY_LORE=
TICKET_CATEGORY_LOG=

TICKET_SUPPORT_ROLES=
TICKET_ROLE_SUPPORT=
TICKET_ROLE_REPORT=
TICKET_ROLE_BUG=
TICKET_ROLE_LORE=

TICKET_SCHEDULE_ENABLED=false

# ------------------------------------------
# 7. Servidor Minecraft de Teste
# ------------------------------------------
SERVER_IP=127.0.0.1
LOBBY_PORT=25565
RPG_PORT=25568
SOCKET_PORT=25590
SOCKET_SECRET=midgard_test_key

# ------------------------------------------
# 8. Banco de Dados (Use um DB separado para teste!)
# ------------------------------------------
DB_TYPE=sqlite
DB_HOST=
DB_PORT=
DB_NAME=midgard_test
DB_USER=
DB_PASS=
